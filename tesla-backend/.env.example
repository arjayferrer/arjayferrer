# --- Tesla Developer App (from developer.tesla.com) ---
TESLA_CLIENT_ID=your_client_id_here
TESLA_CLIENT_SECRET=your_client_secret_here
TESLA_REDIRECT_URI=https://api.arjayferrer.com/api/tesla/callback
TESLA_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com
# ^ region-specific base URL — EU/ME accounts use eu.vn, NA uses na.vn, etc.
# Check developer.tesla.com docs for your account region (UAE/GCC = EU region API).

# --- Your own watch-app auth (you invent this, put it in the watch app too) ---
WATCH_API_KEY=generate_a_long_random_string_here

# --- Storage ---
# Where refresh tokens get persisted. For a single-user personal app,
# a local encrypted JSON file is fine. Do NOT commit this file to git.
TOKEN_STORE_PATH=./data/tesla-tokens.json

# Fallback refresh token for hosts with ephemeral disks (e.g. Render free tier,
# where ./data is wiped on every deploy/restart). After the one-time OAuth login,
# copy the refresh_token value into this env var in the host's dashboard.
# TESLA_REFRESH_TOKEN=

# --- Command signing (production, Docker only) ---
# Paste the full contents of private-key.pem here in your host's dashboard (Render ->
# Environment). The Docker entrypoint writes it to a temp file for tesla-http-proxy and
# sets TESLA_PROXY_URL / TESLA_PROXY_CA itself. Never commit this or put it in .env on a
# shared machine. Alternative: upload private-key.pem as a Render Secret File.
# TESLA_COMMAND_PRIVATE_KEY=

# --- Voice commands (Claude) ---
# Key from console.anthropic.com. Lives only on the backend, never in the watch app.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: Haiku is fast and cheap, which is what you want for a watch.
# VOICE_MODEL=claude-haiku-5-5

PORT=8787
